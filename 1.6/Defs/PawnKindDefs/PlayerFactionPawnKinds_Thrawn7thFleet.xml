	<PawnKindDef Name="SWThrawn7th_EliteStormtrooper" ParentName="SWThrawn7th_StormtrooperCorpsBase">
		<defName>SWThrawn7th_EliteStormtrooper</defName>
		<label>7th Fleet Stormtrooper</label>
		<combatPower>125</combatPower>
		<minGenerationAge>20</minGenerationAge>
		<maxGenerationAge>35</maxGenerationAge>
		<itemQuality>Good</itemQuality>
		
		<backstoryFiltersOverride Inherit="False">
			<li><categories><li>SWCPBSC_NonFactionSpecificChildhoods</li><li>SWCPBSC_7thFleetStormtrooper</li></categories></li>
		</backstoryFiltersOverride>

		<apparelMoney>1500~5500</apparelMoney>
		<apparelAllowHeadgearChance>1</apparelAllowHeadgearChance>
		<apparelTags>
			<li>RemnantEmpire_stormiearmor</li>
			<li>KotOREquipment_adv</li>
			<li>SWGCWSpecificApparelItem_ImperialStormtrooperBackpack</li>
			<li>SWCPSpecificApparelItem_SimpleSuspenders</li>
			<li>SWGCWSpecificApparelItem_ThrawnImperialStormtrooperPauldron</li>
			<li>SWGCWSpecificApparelItem_ImperialStormtrooperHelmet</li>
			<li>SWGCWSpecificApparelItem_ImperialStormtrooperArmor</li>
			<li>SWCPSpecificApparelItem_VacSealedBodysuit</li>
		</apparelTags>
		<apparelRequired>
			<li>guy762_ImpStormtrooperBackpack</li>
			<li>guy762_StormieHelmet</li>
			<li>guy762_Accessory_stormie7thpauldron</li>
			<li>guy762_Accessory_suspendersA</li>
			<li>guy762_StormieArmor</li>
			<li>guy762_Bodysuit</li>
		</apparelRequired>
		<specificApparelRequirements>
			<li>
				<bodyPartGroup>Neck</bodyPartGroup>
				<apparelLayer>Shell</apparelLayer>
				<color>(40,40,40)</color>
			</li>
			<li>
				<bodyPartGroup>Torso</bodyPartGroup>
				<apparelLayer>Shell</apparelLayer>
				<color>(90,90,90)</color>
			</li>
			<li>
				<apparelLayer>OnSkin</apparelLayer>
				<color>(90,90,90)</color>
			</li>
		</specificApparelRequirements>

		<biocodeWeaponChance>0</biocodeWeaponChance>
		<weaponMoney>625~4500</weaponMoney>
		<weaponTags>
			<li>SWRanged_E11tac</li>
			<li>SWRanged_E22rifle</li>
			<li>SWRanged_DXR4DisruptorRifle</li>
			<!-- <li>SWRanged_DLT19repeater</li> -->
		</weaponTags>

		<techHediffsChance>2</techHediffsChance>
		<techHediffsMoney>
			<min>2400</min>
			<max>4800</max>
		</techHediffsMoney>

		<inventoryOptions>
			<skipChance>0</skipChance>
			<subOptionsChooseOne>
				<li>
					<thingDef>guy762_medpac_adv</thingDef>
					<countRange>2~3</countRange>
				</li>
				<li>
					<thingDef>guy762_stim_battle</thingDef>
					<countRange>1~2</countRange>
				</li>
			</subOptionsChooseOne>
		</inventoryOptions>

		<disallowedTraits>
			<li>Brawler</li>
		</disallowedTraits>
		
		<forcedTraits>
			<Tough>0</Tough>
		</forcedTraits>
		
		<startingHediffs>
			<li><def>SWCPHediff_WMFTemporaryDeployment</def><chance>1</chance></li>
		</startingHediffs>
		<modExtensions>
			<li Class="EBSGFramework.ForceStartingHediffsExtension" />
			<li Class="BigAndSmall.PawnKindExtension">
				<skillRange>
					<li>
						<skill>Shooting</skill>
						<range>12~14</range>
					</li>
					<li>
						<skill>Melee</skill>
						<range>8~10</range>
					</li>
				</skillRange>
				<skillRangeApplyToBabies>false</skillRangeApplyToBabies>
			</li>
		</modExtensions>
	</PawnKindDef>
	
	

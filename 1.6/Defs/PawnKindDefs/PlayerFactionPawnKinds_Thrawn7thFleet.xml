<Defs>

	
	<PawnKindDef Name="SWThrawn7thBase" Abstract="True">
		<defaultFactionType>guy762_GCWPlayerFaction_Thrawn7th</defaultFactionType>
		<race>Human</race>
		
		<appearsRandomlyInCombatGroups>false</appearsRandomlyInCombatGroups>
		<!-- <backstoryCryptosleepCommonality>0.08</backstoryCryptosleepCommonality> -->
		<!-- <backstoryFiltersOverride> -->
			<!-- <li> -->
				<!-- <categories> -->
					<!-- <li>Pirate</li> -->
					<!-- <li>Offworld</li> -->
					<!-- <li>Outlander</li> -->
					<!-- <li>ImperialFighter</li> -->
					<!-- <li>Madman</li> -->
				<!-- </categories> -->
			<!-- </li> -->
		<!-- </backstoryFiltersOverride> -->

		<chemicalAddictionChance>0</chemicalAddictionChance>
		<!--combatEnhancingDrugsChance>0.15</combatEnhancingDrugsChance>
		<combatEnhancingDrugsCount>0~2</combatEnhancingDrugsCount-->
		<invNutrition>2</invNutrition>
		<invFoodDef>MealSurvivalPack</invFoodDef>

		<apparelMoney>4000~5000</apparelMoney>

		<techHediffsTags>
			<li>Spacer</li>
			<li>Advanced</li>
			<li>AdvancedWeapon</li>
		</techHediffsTags>
		
		<apparelIgnoreSeasons>true</apparelIgnoreSeasons>
		<allowOldAgeInjuries>False</allowOldAgeInjuries>

		<disallowedTraits>
			<li MayRequire="lee.theforce.standalone">Force_NeutralSensitivity</li>
			<li MayRequire="lee.theforce.standalone">Force_LightAffinity</li>
			<li MayRequire="lee.theforce.standalone">Force_DarkAffinity</li>
			
			<li>BodyPurist</li>
			<li>Nudist</li>
			<li>Wimp</li>
			<li MayRequire="Ludeon.RimWorld.Biotech">Delicate</li>
		</disallowedTraits>

		<isFighter>true</isFighter>
		<requiredWorkTags>
			<li>Violent</li>
			<li>Hauling</li>
		</requiredWorkTags>
		
		<pawnGroupDevelopmentStage>Adult</pawnGroupDevelopmentStage>

		<modExtensions>
			<li Class="BodyTypeForPawnKind.ModExtension_BodyTypesOfPawnKind">
				<whitelist>
					<li>Male</li>
					<li>Female</li>
					<li>Hulk</li>
					<li>Thin</li>
				</whitelist>
				<blacklist>
					<!-- <li>Fat</li> -->
					<!-- <li>Baby</li> -->
					<!-- <li>Child</li> -->
				</blacklist>
				<priority>
					<!--When violates the black/whitelist, selected from these-->
				</priority>
				<!--Align body gender to pawn's gender (default: True)-->
				<checkGender>True</checkGender>
			</li>
		</modExtensions>
	</PawnKindDef>





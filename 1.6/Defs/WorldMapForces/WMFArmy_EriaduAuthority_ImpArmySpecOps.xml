			<li>guy762_NamerFactionFiles_GenericFleetName</li>
			<li>guy762_NamerFactionFiles_EriaduPlanets</li>
		</include>
		<rulePack>
			<rulesStrings>
				<li>r_name(p=6)->[SWFN_BigFleetNumber] [SWEAFN_AnyPlanet] [taskforce]</li>
				
				<li>taskforce->Task Force</li>
			</rulesStrings>
		</rulePack>
	</RulePackDef>

	
</Defs>
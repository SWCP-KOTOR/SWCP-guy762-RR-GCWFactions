<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	
	<RoyalTitlePermitDef>
		<defName>SWGCWPermit_EriaduAuthority_SummonImpArmySpecOpsForce</defName>
		<label>establish Imperial Army Special Missions platoon</label>
		<description>Establish a platoon of Imperial Army Special Missions troopers on the world map.\n\nNOTE: Because of technical reasons, the spawned object will be placed on a tile on the vanilla Rimworld planet. Use their "launch" ability after it spawns to bring it to the tile you want.</description>
		<workerClass>ForcesMod.RoyalTitlePermitWorker_SpawnWorldObject</workerClass>
		
		<faction>guy762_SWWarlordsFaction_EriaduAuthority</faction>
		<minTitle>SWGCWTitle_generic_lowflagofficer</minTitle>
		
		<permitPointCost>10</permitPointCost>
		<cooldownDays>40</cooldownDays>
		<usableOnWorldMap>true</usableOnWorldMap>
		<uiPosition>(9,9)</uiPosition>
		<royalAid>
			<favorCost>8</favorCost>
			<targetingRequireLOS>false</targetingRequireLOS>
		</royalAid>
		<!-- orbitals and other planets don't work *yet* -->
		<layerBlacklist>
			<li MayRequire="Ludeon.RimWorld.Odyssey">Orbit</li>
			<!-- <li MayRequire="MrHydralisk.LayeredAtmosphereOrbit">LAO_Surface_Luna</li> -->
			
			<!-- <li MayRequire="SWCP.guy762.Taran.SWGalaxy.gbp">SWCPPlanetLayer_Tatooine</li> -->
			<li MayRequire="SWCP.guy762.Taran.SWGalaxy.gbp">SWCPPlanetLayer_TatooineOrbit</li>
			<!-- <li MayRequire="SWCP.guy762.Taran.SWGalaxy.gbp">SWCPPlanetLayer_OrdMantell</li> -->
			<li MayRequire="SWCP.guy762.Taran.SWGalaxy.gbp">SWCPPlanetLayer_OrdMantellOrbit</li>
			
			<!-- <li MayRequire="SWCP.guy762.Taran.SWGalaxy.gbp">SWCPPlanetLayer_RhenVar</li> -->
			<li MayRequire="SWCP.guy762.Taran.SWGalaxy.gbp">SWCPPlanetLayer_RhenVarOrbit</li>
			<!-- <li MayRequire="SWCP.guy762.Taran.SWGalaxy.gbp">SWCPPlanetLayer_Nevarro</li> -->
			<li MayRequire="SWCP.guy762.Taran.SWGalaxy.gbp">SWCPPlanetLayer_NevarroOrbit</li>
			
			<!-- <li MayRequire="SWCP.guy762.Taran.SWGalaxy.gbp">SWCPPlanetLayer_Onderon</li> -->
			<li MayRequire="SWCP.guy762.Taran.SWGalaxy.gbp">SWCPPlanetLayer_OnderonOrbit</li>
			<!-- <li MayRequire="SWCP.guy762.Taran.SWGalaxy.gbp">SWCPPlanetLayer_Dxun</li> -->
		</layerBlacklist>
		<modExtensions>
			<li Class="ForcesMod.ForceAbilitiesModExtension">
				<permitSpawnsWorldObject>SWCPArmyForce_EriaduAuthority_ImpArmySpecOps</permitSpawnsWorldObject>
			</li>
			<li Class="SWCP_FlyingSloth_Misc.PermitExtension_SingleUse"><singleUse>true</singleUse></li>
		</modExtensions>
	</RoyalTitlePermitDef>
	
	
	
	
	
	
	
	<WorldObjectDef>
		<defName>SWCPArmyForce_EriaduAuthority_ImpArmySpecOps</defName>
		<label>Imperial Army Special Missions platoon</label>
		<description>A mobilized platoon of Imperial Army Special Missions troopers.\n\nThis gathering of armed forces is fully self-sufficient and requires no input from the player to support itself. This unit has its own supply officers and recruiters capable of keeping its supplies stocked and its number of battle-ready soldiers high. It can send forth a full deployment of NPC troops to assist you in battle every 10 days, and can also contribute small reinforcement squads and strike teams for your direct control every 1-3 days.</description>
		<!-- <description>A mobilized platoon of Imperial Army troopers.\n\nThis gathering of armed forces is fully self-sufficient and requires no input from the player to support itself. This unit has its own supply officers and recruiters capable of keeping its supplies stocked and its number of battle-ready soldiers high. It can send forth a full deployment of NPC troops to assist you in battle every 10 days, and can also contribute small reinforcement squads and strike teams for your direct control every 1-3 days.\n\nImperial Army troopers are the core vanguard unit of the Empire's ground armies, and are used primarily to take and hold ground. Their objective is to be difficult for the enemy to dislodge, buying time for elite forces, mechanized units, and expert commanders to arrive on the field. To achieve this, they are equipped with bulky, durable armor and an assortment of BlasTech rifles and carbines. However, what these platoons make up for in numbers and armor, they lack in heavy firepower. A typical deployment only includes four anti-armor grenadiers and one ion gunner, and as a result these units will struggle against armored targets like turrets and vehicles. Additionally, their heavy body armor is quite restrictive to movement, and these troopers will have difficulty maneuvering with haste in most situations.</description> -->
		
		<texture>UI/WorldMapForceIcons_Armies/WMFIcon_ImpArmySpecOps</texture><!--  for some dumbass reason the game rotates this texture 90 degrees clockwise -->
		<expandingIconTexture>UI/WorldMapForceIcons_Armies/WMFIcon_ImpArmySpecOps</expandingIconTexture>
		<fullyExpandedInSpace>true</fullyExpandedInSpace>
		<expandingIcon>true</expandingIcon>
		<expandingIconPriority>10</expandingIconPriority>
		<expandMore>true</expandMore>
		<useDynamicDrawer>true</useDynamicDrawer>
		<rotateGraphicWhenTraveling>false</rotateGraphicWhenTraveling>
		
		<worldObjectClass>ForcesMod.WorldObject_Force</worldObjectClass><validLaunchTarget>false</validLaunchTarget>
		<nameMaker>SWCPNameMaker_WorldMapForce_ImpArmySpecOpsPlatoon_EriaduAuthority</nameMaker>
		
		<modExtensions>
			<li Class="ForcesMod.ForceAbilitiesModExtension">
				<abilityRange>8</abilityRange>
				<forceNameString>SWCPWorldMapForceNameString_ImpArmySpecOpsPlatoon</forceNameString>
				<movementSpeedPerDay>24</movementSpeedPerDay>
				<abilities>
					<li>SWCPWMFAbility_EriaduAuthority_SummonNPCRaid_ImpArmySpecOps_full</li>
					<li>SWCPWMFAbility_EriaduAuthority_SummonPlayerUnits_ImpArmySpecOps_small</li>
					<li>SWCPWMFAbility_EriaduAuthority_SummonPlayerUnits_ImpArmySpecOps_big</li>
					
					<li>SWCPWMFAbility_ArtilleryBombardment_antiVehicle</li>
					<li>SWCPWMFAbility_SiegeSettlement_ImpArmySpecOps</li>
					<li>SWCPWMFAbility_ReclaimSettlement_EriaduAuthority</li>
					<li>SWCPWMFAbility_SlowLaunchForGroundForces</li>
				</abilities>
			</li>
		</modExtensions>
	</WorldObjectDef>
	<ForcesMod.ForceAbilityDef>
		<defName>SWCPWMFAbility_SiegeSettlement_ImpArmySpecOps</defName>
		<label>seige settlement</label>
		<description>Order an assault on an enemy settlement, which may or may not succeed.</description>
		<workerClass>ForcesMod.ForceAbilityWorker_DestroySettlement</workerClass>
		<iconPath>UI/WorldMapForces_Abilities/GUY_DestroySettlement</iconPath>
		<requiresTarget>true</requiresTarget>
		
		<!-- 900,000 = 15 in-game days -->
		<cooldownTicks>900000</cooldownTicks>
		<successChance>0.7</successChance>
		<criticalFailureChance>0.15</criticalFailureChance>
	</ForcesMod.ForceAbilityDef>
	
	
	
	
	
	<ForcesMod.ForceAbilityDef>
		<defName>SWCPWMFAbility_EriaduAuthority_SummonNPCRaid_ImpArmySpecOps_full</defName>
		<label>deploy full platoon (NPC)</label>
		<description>Deploy the full platoon as friendly NPCs.</description>
		<workerClass>ForcesMod.ForceAbilityWorker_SpawnRaid</workerClass>
		
		<iconPath>UI/WorldMapForceIcons_Deployments/EriaduAuthority_ImpArmySpecOps_NPC</iconPath>
		<requiresTarget>true</requiresTarget>
		
		<!-- 600,000 = 10 in-game days -->
		<cooldownTicks>600000</cooldownTicks>
		
		<faction>guy762_SWWarlordsFaction_EriaduAuthority</faction>
		<relevantPawnKinds>
			<xSWEriadu_ArmySpecOps_25x>25</xSWEriadu_ArmySpecOps_25x>
			<xSWEriadu_ArmySpecOpsLightRepeater_2x>2</xSWEriadu_ArmySpecOpsLightRepeater_2x>
			<xSWEriadu_ArmySpecOpsHeavyRepeater_3x>3</xSWEriadu_ArmySpecOpsHeavyRepeater_3x>
			<xSWEriadu_ArmySpecOpsMissile_6x>6</xSWEriadu_ArmySpecOpsMissile_6x>
			<xSWEriadu_ArmyMedic_2x>2</xSWEriadu_ArmyMedic_2x>
			<xSWEriadu_ArmyLieutenant_2x>2</xSWEriadu_ArmyLieutenant_2x>
		</relevantPawnKinds>
	</ForcesMod.ForceAbilityDef>
	
	<ForcesMod.ForceAbilityDef>
		<defName>SWCPWMFAbility_EriaduAuthority_SummonPlayerUnits_ImpArmySpecOps_small</defName>
		<label>deploy reinforcement squad (Player)</label>
		<description>Deploy a player-controlled 6-man reinforcement squad.</description>
		<workerClass>ForcesMod.ForceAbilityWorker_SpawnRaid</workerClass>
		
		<iconPath>UI/WorldMapForceIcons_Deployments/EriaduAuthority_ImpArmySpecOps_PlayerSmall</iconPath>
		<requiresTarget>true</requiresTarget>
		
		<!-- 60,000 = 1 in-game day -->
		<cooldownTicks>60000</cooldownTicks>
		
		<!-- <faction>guy762_GCWPlayerFaction_Thrawn7th</faction> -->
		<usesPlayerFaction>True</usesPlayerFaction><noStrategy>True</noStrategy>
		<relevantPawnKinds>
			<xpSWEriadu_ArmySpecOps_playable>6</xpSWEriadu_ArmySpecOps_playable>
		</relevantPawnKinds>
	</ForcesMod.ForceAbilityDef>
	
	<ForcesMod.ForceAbilityDef>
		<defName>SWCPWMFAbility_EriaduAuthority_SummonPlayerUnits_ImpArmySpecOps_big</defName>
		<label>deploy strike team (Player)</label>
		<description>Deploy a player-controlled 16-man strike team.</description>
		<workerClass>ForcesMod.ForceAbilityWorker_SpawnRaid</workerClass>
		
		<iconPath>UI/WorldMapForceIcons_Deployments/EriaduAuthority_ImpArmySpecOps_PlayerLarge</iconPath>
		<requiresTarget>true</requiresTarget>
		
		<!-- 180,000 = 3 in-game days -->
		<cooldownTicks>180000</cooldownTicks>
		
		<!-- <faction>guy762_GCWPlayerFaction_Thrawn7th</faction> -->
		<usesPlayerFaction>True</usesPlayerFaction><noStrategy>True</noStrategy>
		<relevantPawnKinds>
			<xpSWEriadu_ArmySpecOps_playable>10</xpSWEriadu_ArmySpecOps_playable>
			<xpSWEriadu_ArmySpecOpsLightRepeater_playable>1</xpSWEriadu_ArmySpecOpsLightRepeater_playable>
			<xpSWEriadu_ArmySpecOpsHeavyRepeater_playable>1</xpSWEriadu_ArmySpecOpsHeavyRepeater_playable>
			<xpSWEriadu_ArmySpecOpsMissile_playable>2</xpSWEriadu_ArmySpecOpsMissile_playable>
			<xpSWWarlords_ArmyMedic_playable>1</xpSWWarlords_ArmyMedic_playable>
			<xpSWEriadu_ArmyLieutenant_playable>1</xpSWEriadu_ArmyLieutenant_playable>
		</relevantPawnKinds>
	</ForcesMod.ForceAbilityDef>
	


	
	
	
	<RulePackDef>
		<defName>SWCPNameMaker_WorldMapForce_ImpArmySpecOpsPlatoon_EriaduAuthority</defName>

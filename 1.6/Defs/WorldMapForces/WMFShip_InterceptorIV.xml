<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	
	<RoyalTitlePermitDef Name="SWGCWPermit_SummonForce_InterceptorIVBASE" Abstract="True">
		<!-- <defName>SWGCWPermit_ZsinjDominion_SummonForce_InterceptorIV</defName> -->
		<label>deploy Interceptor-IV Frigate</label>
		<description>Deploy an Interceptor-IV Frigate on the world map.\n\nNOTE: Because of technical reasons, the spawned object will be placed on a tile on the vanilla Rimworld planet. Use their "launch" ability after it spawns to bring it to the tile you want.</description>
		<workerClass>ForcesMod.RoyalTitlePermitWorker_SpawnWorldObject</workerClass>
		
		<!-- <faction>guy762_SWWarlordsFaction_ZsinjDominion</faction> -->
		<minTitle>SWGCWTitle_generic_lowseniorofficer</minTitle>
		
		<permitPointCost>10</permitPointCost>
		<cooldownDays>40</cooldownDays>
		<usableOnWorldMap>true</usableOnWorldMap>
		<uiPosition>(10,4)</uiPosition>
		<royalAid>
			<favorCost>8</favorCost>
			<targetingRequireLOS>false</targetingRequireLOS>
		</royalAid>
		<!-- orbitals and other planets don't work *yet* -->
		<layerBlacklist>
			<li MayRequire="Ludeon.RimWorld.Odyssey">Orbit</li>
			<!-- <li MayRequire="MrHydralisk.LayeredAtmosphereOrbit">LAO_Surface_Luna</li> -->
			
			<!-- <li MayRequire="SWCP.guy762.Taran.SWGalaxy.gbp">SWCPPlanetLayer_Tatooine</li> -->
			<li MayRequire="SWCP.guy762.Taran.SWGalaxy.gbp">SWCPPlanetLayer_TatooineOrbit</li>
			<!-- <li MayRequire="SWCP.guy762.Taran.SWGalaxy.gbp">SWCPPlanetLayer_OrdMantell</li> -->
			<li MayRequire="SWCP.guy762.Taran.SWGalaxy.gbp">SWCPPlanetLayer_OrdMantellOrbit</li>
			
			<!-- <li MayRequire="SWCP.guy762.Taran.SWGalaxy.gbp">SWCPPlanetLayer_RhenVar</li> -->
			<li MayRequire="SWCP.guy762.Taran.SWGalaxy.gbp">SWCPPlanetLayer_RhenVarOrbit</li>
			<!-- <li MayRequire="SWCP.guy762.Taran.SWGalaxy.gbp">SWCPPlanetLayer_Nevarro</li> -->
			<li MayRequire="SWCP.guy762.Taran.SWGalaxy.gbp">SWCPPlanetLayer_NevarroOrbit</li>
			
			<!-- <li MayRequire="SWCP.guy762.Taran.SWGalaxy.gbp">SWCPPlanetLayer_Onderon</li> -->
			<li MayRequire="SWCP.guy762.Taran.SWGalaxy.gbp">SWCPPlanetLayer_OnderonOrbit</li>
			<!-- <li MayRequire="SWCP.guy762.Taran.SWGalaxy.gbp">SWCPPlanetLayer_Dxun</li> -->
		</layerBlacklist>
		<modExtensions>
			<li Class="ForcesMod.ForceAbilitiesModExtension">
				<permitSpawnsWorldObject>SWCPShipForce_InterceptorIV</permitSpawnsWorldObject>
			</li>
			<li Class="SWCP_FlyingSloth_Misc.PermitExtension_SingleUse"><singleUse>true</singleUse></li>
		</modExtensions>
	</RoyalTitlePermitDef>
	
	<RoyalTitlePermitDef ParentName="SWGCWPermit_SummonForce_InterceptorIVBASE">
		<defName>SWGCWPermit_ZsinjDominion_SummonForce_InterceptorIV</defName>
		<faction>guy762_SWWarlordsFaction_ZsinjDominion</faction>
	</RoyalTitlePermitDef>
	
	<RoyalTitlePermitDef ParentName="SWGCWPermit_SummonForce_InterceptorIVBASE">
		<defName>SWGCWPermit_HuttCartel_SummonForce_InterceptorIV</defName>
		<faction>guy762_SWWarlordsFaction_HuttCartel</faction>
		<minTitle>SWGCWTitle_HuttCartels_lowtrader</minTitle>
	</RoyalTitlePermitDef>
	
	<!-- also available to Black Sun and Zann Consortium -->
	
	
	
	
	
	
	
	
	<WorldObjectDef>
		<defName>SWCPShipForce_InterceptorIV</defName>
		<label>Interceptor-IV Frigate</label>
		<description>.</description>
		
		<texture>UI/WorldMapForceIcons_Ships/WMFIcon_InterceptorIV</texture><!--  for some dumbass reason the game rotates this texture 90 degrees clockwise -->
		<expandingIconTexture>UI/WorldMapForceIcons_Ships/WMFIcon_InterceptorIV</expandingIconTexture>
		<expandingIconDrawSize>1</expandingIconDrawSize>
		<!-- <expandingIconDrawSize>10</expandingIconDrawSize> like SSD-sized -->
		
		<fullyExpandedInSpace>true</fullyExpandedInSpace>
		<expandingIcon>true</expandingIcon>
		<expandingIconPriority>10</expandingIconPriority>
		<expandMore>true</expandMore>
		<!-- <useDynamicDrawer>true</useDynamicDrawer> -->
		<rotateGraphicWhenTraveling>false</rotateGraphicWhenTraveling>
		
		<worldObjectClass>ForcesMod.WorldObject_Force</worldObjectClass><validLaunchTarget>false</validLaunchTarget>
		<nameMaker>NamerFactionPirate</nameMaker>
		
		<modExtensions>
			<li Class="ForcesMod.ForceAbilitiesModExtension">
				<abilityRange>4</abilityRange>
				<forceNameString>SWCPWorldMapForceNameString_InterceptorIV</forceNameString>
				<movementSpeedPerDay>36</movementSpeedPerDay>
				<abilities>
					<li>SWCPWMFAbility_Invids_SummonPlayerUnits_InvidPirates_small</li>
					<li>SWCPWMFAbility_Invids_SummonPlayerUnits_InvidPirates_big</li>
					
					<li>SWCPWMFAbility_ArtilleryBombardment_antiVehicle</li>
					<li>SWCPWMFAbility_DestroySettlement</li>
					
					<li>SWCPWMFAbility_Launch_InterceptorIV</li>
				</abilities>
			</li>
		</modExtensions>
	</WorldObjectDef>
	
	<ForcesMod.ForceAbilityDef>
		<defName>SWCPWMFAbility_Launch_InterceptorIV</defName>
		<label>launch</label>
		<description>Launch this force to any tile.</description>
		<workerClass>ForcesMod.ForceAbilityWorker_Launch</workerClass>
		<iconPath>UI/WorldMapForces_Abilities/GUY_LaunchForce</iconPath>
		<launchTilesPerDay>240</launchTilesPerDay>
		<ignoresAbilityRange>true</ignoresAbilityRange>
		<cooldownTicks>30000</cooldownTicks> <!-- half a day -->
		<requiresTargetTile>true</requiresTargetTile>
	</ForcesMod.ForceAbilityDef>
	
	
	
	
	

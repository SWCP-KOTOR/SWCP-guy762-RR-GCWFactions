	<WorldObjectDef>
		<defName>SWCPShipForce_ISD</defName>
		<label>Imperial-class Star Destroyer</label>
		<description>.</description>
		
		<texture>UI/WorldMapForceIcons_Ships/WMFIcon_ISD</texture><!--  for some dumbass reason the game rotates this texture 90 degrees clockwise -->
		<expandingIconTexture>UI/WorldMapForceIcons_Ships/WMFIcon_ISD</expandingIconTexture>
		<expandingIconDrawSize>5</expandingIconDrawSize>
		<!-- <expandingIconDrawSize>10</expandingIconDrawSize> like SSD-sized -->
		
		<fullyExpandedInSpace>true</fullyExpandedInSpace>
		<expandingIcon>true</expandingIcon>
		<expandingIconPriority>10</expandingIconPriority>
		<expandMore>true</expandMore>
		<!-- <useDynamicDrawer>true</useDynamicDrawer> -->
		<rotateGraphicWhenTraveling>false</rotateGraphicWhenTraveling>
		
		<worldObjectClass>ForcesMod.WorldObject_Force</worldObjectClass><validLaunchTarget>false</validLaunchTarget>
		<nameMaker>SWCPNameMaker_WorldMapForce_Ship_ISD</nameMaker>
		
		<modExtensions>
			<li Class="ForcesMod.ForceAbilitiesModExtension">
				<abilityRange>8</abilityRange>
				<forceNameString>SWCPWorldMapForceNameString_ISD</forceNameString>
				<movementSpeedPerDay>36</movementSpeedPerDay>
				<abilities>
					<li>SWCPWMFAbility_ImpRemnant_SummonPlayerUnits_ImpArmyTroopers_small</li>
					<li>SWCPWMFAbility_ImpRemnant_SummonPlayerUnits_ImpArmyTroopers_big</li>
					<li>SWCPWMFAbility_GreaterMaldrood_SummonPlayerUnits_ImpNavyTroopers_small</li>
					<li>SWCPWMFAbility_ImpRemnant_SummonPlayerUnits_Stormtroopers_small</li>
					<li>SWCPWMFAbility_ImpRemnant_SummonPlayerUnits_Stormtroopers_big</li>
					<li>SWCPWMFAbility_ImpRemnant_SummonPlayerUnits_ScoutTroopers</li>
					
					<li>SWCPWMFAbility_ArtilleryBombardment_antiVehicle</li>
					<li>SWCPWMFAbility_DestroySettlement</li>
					
					<li>SWCPWMFAbility_Launch_ISD</li>
				</abilities>
			</li>
		</modExtensions>
	</WorldObjectDef>
	
	<ForcesMod.ForceAbilityDef>
		<defName>SWCPWMFAbility_Launch_ISD</defName>
		<label>launch</label>
		<description>Launch this force to any tile.</description>
		<workerClass>ForcesMod.ForceAbilityWorker_Launch</workerClass>
		<iconPath>UI/WorldMapForces_Abilities/GUY_LaunchForce</iconPath>
		<launchTilesPerDay>240</launchTilesPerDay>
		<ignoresAbilityRange>true</ignoresAbilityRange>
		<cooldownTicks>60000</cooldownTicks> <!-- 1 day -->
		<requiresTargetTile>true</requiresTargetTile>
	</ForcesMod.ForceAbilityDef>
	
	
	
	
	
	<RulePackDef>

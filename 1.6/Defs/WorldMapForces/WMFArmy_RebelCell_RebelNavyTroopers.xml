<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	
	
	<!-- unbuildable unit, used for ability sampling by Rebel ships -->
	
	
	<WorldObjectDef>
		<defName>SWCPArmyForce_RebelCell_RebelNavyTroopers</defName>
		<label>Rebel Navy trooper detachment</label>
		<description>A mobilized platoon of Rebel Navy troopers.\n\nThis gathering of armed forces is fully self-sufficient and requires no input from the player to support itself. This unit has its own supply officers and recruiters capable of keeping its supplies stocked and its number of battle-ready soldiers high. It can send forth a full deployment of NPC troops to assist you in battle every 10 days, and can also contribute small reinforcement squads and strike teams for your direct control every 1-3 days.</description>
		<!-- <description>A mobilized platoon of Imperial Army troopers.\n\nThis gathering of armed forces is fully self-sufficient and requires no input from the player to support itself. This unit has its own supply officers and recruiters capable of keeping its supplies stocked and its number of battle-ready soldiers high. It can send forth a full deployment of NPC troops to assist you in battle every 10 days, and can also contribute small reinforcement squads and strike teams for your direct control every 1-3 days.\n\nImperial Army Troopers are the core vanguard unit of the Empire's ground armies, and are used primarily to take and hold ground. Their objective is to be difficult for the enemy to dislodge, buying time for elite forces, mechanized units, and expert commanders to arrive on the field. To achieve this, they are equipped with bulky, durable armor and an assortment of BlasTech rifles and carbines. However, what these platoons make up for in numbers and armor, they lack in heavy firepower. A typical deployment only includes four anti-armor grenadiers and one ion gunner, and as a result these units will struggle against armored targets like turrets and vehicles. Additionally, their heavy body armor is quite restrictive to movement, and these troopers will have difficulty maneuvering with haste in most situations.</description> -->
		
		<texture>UI/WorldMapForceIcons_Armies/WMFIcon_RebelNavyTrooper</texture><!--  for some dumbass reason the game rotates this texture 90 degrees clockwise -->
		<expandingIconTexture>UI/WorldMapForceIcons_Armies/WMFIcon_RebelNavyTrooper</expandingIconTexture>
		<fullyExpandedInSpace>true</fullyExpandedInSpace>
		<expandingIcon>true</expandingIcon>
		<expandingIconPriority>10</expandingIconPriority>
		<expandMore>true</expandMore>
		<useDynamicDrawer>true</useDynamicDrawer>
		<rotateGraphicWhenTraveling>false</rotateGraphicWhenTraveling>
		
		<worldObjectClass>ForcesMod.WorldObject_Force</worldObjectClass><validLaunchTarget>false</validLaunchTarget>
		<nameMaker>SWCPNameMaker_WorldMapForce_RebelNavyPlatoon</nameMaker>
		
		<modExtensions>
			<li Class="ForcesMod.ForceAbilitiesModExtension">
				<abilityRange>8</abilityRange>
				<forceNameString>SWCPWorldMapForceNameString_RebelNavyPlatoon</forceNameString>
				<movementSpeedPerDay>36</movementSpeedPerDay>
				<abilities>
					<li>SWCPWMFAbility_RebelCell_SummonNPCRaid_RebelNavyTroopers_full</li>
					<li>SWCPWMFAbility_RebelCell_SummonPlayerUnits_RebelNavyTroopers_small</li>
					<li>SWCPWMFAbility_RebelCell_SummonPlayerUnits_RebelNavyTroopers_big</li>
					
					<!-- <li>SWCPWMFAbility_ArtilleryBombardment_antiVehicle</li> -->
					<li>SWCPWMFAbility_SiegeSettlement_RebelNavyTroopers</li>
					<li>SWCPWMFAbility_ReclaimSettlement_NewRepublic</li>
					<li>SWCPWMFAbility_SlowLaunchForGroundForces</li>
				</abilities>
			</li>
		</modExtensions>
	</WorldObjectDef>
	<ForcesMod.ForceAbilityDef>
		<defName>SWCPWMFAbility_SiegeSettlement_RebelNavyTroopers</defName>
		<label>seige settlement</label>
		<description>Order an assault on an enemy settlement, which may or may not succeed.</description>
		<workerClass>ForcesMod.ForceAbilityWorker_DestroySettlement</workerClass>
		<iconPath>UI/WorldMapForces_Abilities/GUY_DestroySettlement</iconPath>
		<requiresTarget>true</requiresTarget>
		
		<!-- 900,000 = 15 in-game days -->
		<cooldownTicks>900000</cooldownTicks>
		<successChance>0.1</successChance>
		<criticalFailureChance>0.7</criticalFailureChance>
	</ForcesMod.ForceAbilityDef>
	
	
	
	
	
	
	<ForcesMod.ForceAbilityDef>
		<defName>SWCPWMFAbility_RebelCell_SummonNPCRaid_RebelNavyTroopers_full</defName>
		<label>deploy full platoon (NPC)</label>
		<description>Deploy the full platoon as friendly NPCs.</description>
		<workerClass>ForcesMod.ForceAbilityWorker_SpawnRaid</workerClass>
		
		<iconPath>UI/WorldMapForceIcons_Deployments/RebelCell_RebelNavyTrooper_NPC</iconPath>
		<requiresTarget>true</requiresTarget>
		
		<!-- 600,000 = 10 in-game days -->
		<cooldownTicks>600000</cooldownTicks>
		
		<faction>guy762_SWWarlordsFaction_RebelCell</faction>
		<relevantPawnKinds>
			<xSWRebel_FleetTrooper_16x>16</xSWRebel_FleetTrooper_16x>
			<xSWRebel_FleetTrooperRifle_14x>14</xSWRebel_FleetTrooperRifle_14x>

			<xSWRebel_Medic_2x>2</xSWRebel_Medic_2x>
			<xSWRebel_ArmyLieutenant_2x>2</xSWRebel_ArmyLieutenant_2x>
		</relevantPawnKinds>
	</ForcesMod.ForceAbilityDef>
	
	<ForcesMod.ForceAbilityDef>
		<defName>SWCPWMFAbility_RebelCell_SummonPlayerUnits_RebelNavyTroopers_small</defName>
		<label>deploy reinforcement squad (Player)</label>
		<description>Deploy a player-controlled 6-man reinforcement squad.</description>
		<workerClass>ForcesMod.ForceAbilityWorker_SpawnRaid</workerClass>
		
		<iconPath>UI/WorldMapForceIcons_Deployments/RebelCell_RebelNavyTrooper_PlayerSmall</iconPath>
		<requiresTarget>true</requiresTarget>
		
		<!-- 60,000 = 1 in-game day -->
		<cooldownTicks>60000</cooldownTicks>
		
		<usesPlayerFaction>True</usesPlayerFaction><noStrategy>True</noStrategy>
		<relevantPawnKinds>
			<xpSWRebel_NavyTrooper_playable>6</xpSWRebel_NavyTrooper_playable>
		</relevantPawnKinds>
	</ForcesMod.ForceAbilityDef>
	
	<ForcesMod.ForceAbilityDef>
		<defName>SWCPWMFAbility_RebelCell_SummonPlayerUnits_RebelNavyTroopers_big</defName>
		<label>deploy strike team (Player)</label>
		<description>Deploy a player-controlled 12-man strike team.</description>
		<workerClass>ForcesMod.ForceAbilityWorker_SpawnRaid</workerClass>
		
		<iconPath>UI/WorldMapForceIcons_Deployments/RebelCell_RebelNavyTrooper_PlayerLarge</iconPath>
		<requiresTarget>true</requiresTarget>
		
		<!-- 180,000 = 3 in-game days -->
		<cooldownTicks>180000</cooldownTicks>
		
		<usesPlayerFaction>True</usesPlayerFaction><noStrategy>True</noStrategy>
		<relevantPawnKinds>
			<xpSWRebel_NavyTrooper_playable>12</xpSWRebel_NavyTrooper_playable>
		</relevantPawnKinds>
	</ForcesMod.ForceAbilityDef>
	
	
	
	
	






	
	
	
	<RulePackDef>
		<defName>SWCPNameMaker_WorldMapForce_RebelNavyPlatoon</defName>
		<!-- <rulePack> -->
			<!-- <rulesStrings> -->
				<!-- <li>r_name-&gt;force 1</li> -->
			<!-- </rulesStrings> -->
		<!-- </rulePack> -->
		<include>
			<li>guy762_NamerFactionFiles_GenericFleetName</li>
			<li>guy762_NamerFactionFiles_NewRepublicPlanets</li>
		</include>
		<rulePack>
		  <rulesStrings>
			<li>r_name(p=12)->[SWFN_SmallFleetNumber] [SWNRFN_AnyPlanet] [detachment]</li>
			
			<li>detachment->Detachment</li>
		  </rulesStrings>
		</rulePack>
	</RulePackDef>

	
</Defs>